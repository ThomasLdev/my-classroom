<div{{ attributes.defaults({ class: 'session-board' }) }}>
    {% set detail = this.detail %}
    {% set total = detail.activities|length %}
    {% set done = detail.activities|filter(a => a.done)|length %}

    <section class="section">
        <div class="section__head">
            <h2 class="section__title">Activités</h2>
            {% if total > 0 %}<span class="section__count tnum">{{ done }}/{{ total }} terminées</span>{% endif %}
        </div>

        {% if total > 0 %}
            <ul class="act-list">
                {% for a in detail.activities %}
                    <li>
                        <button type="button" class="act{{ a.done ? ' act--done' }}"
                                aria-pressed="{{ a.done ? 'true' : 'false' }}"
                                data-action="live#action"
                                data-live-action-param="{{ a.done ? 'markNotDone' : 'markDone' }}"
                                data-live-activity-id-param="{{ a.id }}">
                            <span class="act__box"><twig:ux:icon name="lucide:check" class="act__check-icon" /></span>
                            <span class="act__title">{{ a.title }}</span>
                            {% if a.carriedOver %}<span class="act__flag">reporté</span>{% endif %}
                        </button>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="session-activities__empty">Aucune activité prévue — ajoutez-en une ci-dessous.</p>
        {% endif %}

        <form class="add-row" data-action="live#action:prevent" data-live-action-param="addActivity">
            <input class="add-row__input" type="text"
                   data-model="norender|newTitle"
                   value="{{ newTitle }}"
                   placeholder="Ajouter une activité…" autocomplete="off" aria-label="Nouvelle activité">
            <button type="submit" class="btn btn--sm">Ajouter</button>
        </form>
    </section>

    <section class="section">
        <div class="section__head">
            <h2 class="section__title">Notes de séance</h2>
        </div>
        <textarea class="notearea" data-model="debounce(600)|note"
                  placeholder="Ce qui a marché, les élèves à revoir, les points à reprendre la prochaine fois…">{{ note }}</textarea>
        {% if note|trim is not empty %}
            <p class="note-saved">
                <twig:ux:icon name="lucide:circle-check" class="note-saved__icon" /> Enregistré automatiquement
            </p>
        {% endif %}
    </section>
</div>
